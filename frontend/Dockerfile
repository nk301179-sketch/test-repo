FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_USER_MGMT_BASE_URL
ENV VITE_USER_MGMT_BASE_URL=$VITE_USER_MGMT_BASE_URL
ARG VITE_COMPANY_APP_BASE_URL
ENV VITE_COMPANY_APP_BASE_URL=$VITE_COMPANY_APP_BASE_URL
ARG VITE_OAUTH_REDIRECT_URI
ENV VITE_OAUTH_REDIRECT_URI=$VITE_OAUTH_REDIRECT_URI
ARG VITE_PRODUCT_SERVICE_URL
ENV VITE_PRODUCT_SERVICE_URL=$VITE_PRODUCT_SERVICE_URL
ARG VITE_SENDJOB_SERVICE_URL
ENV VITE_SENDJOB_SERVICE_URL=$VITE_SENDJOB_SERVICE_URL
RUN npm run build

FROM node:20-alpine
WORKDIR /app

COPY --from=builder /app/dist ./dist

RUN npm install -g serve

EXPOSE 5173
CMD ["serve", "-s", "dist", "-l", "5173"]
